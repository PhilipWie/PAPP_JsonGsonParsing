<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:layout_gravity="center"
              android:orientation="vertical">
    <TextView
            android:text="@string/papp_text"
            android:id="@+id/idTextView"
            android:background="@color/blue_grey_300"
            android:layout_width="wrap_content"
            android:textSize="50sp"
            android:layout_height="wrap_content"/>
    <TextView
            android:text="Gewicht 2 (2/6 der Höhe)"
            android:id="@+id/idTextView2"
            android:background="@color/amber_300"
            android:textColor="@color/white"
            android:gravity="center"
            android:textSize="30sp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2" />

    <TextView
            android:text="Gewicht 3 (3/6 der Höhe)"
            android:id="@+id/idTextView3"
            android:background="@color/blue_100"
            android:textColor="@color/white"
            android:gravity="center"
            android:textSize="30sp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3" />
</LinearLayout>