<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

    <TextView
            android:id="@+id/idTvDefault"
            android:text="Keine Positionierung → oben links (Standard)"
            android:background="@color/blue_100"
            android:textColor="@color/white"
            android:padding="12dp"
            android:layout_width="wrap_content"
            android:layout_height="100dp" />

    <TextView
            android:id="@+id/idTvTop"
            android:text="layout_alignParentTop=true → oben"
            android:background="@color/amber_300"
            android:textColor="@color/white"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true" />

    <TextView
            android:id="@+id/idTvBottom"
            android:text="layout_alignParentBottom=true → unten"
            android:background="@color/brown_300"
            android:textColor="@color/white"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true" />

    <TextView
            android:id="@+id/tvStart"
            android:text="alignParentStart"
            android:background="@color/green_100"
            android:textColor="@color/white"
            android:padding="12dp"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true" />

    <TextView
            android:id="@+id/tvCenter"
            android:text="centerHorizontal"
            android:background="@color/red_100"
            android:textColor="@color/black"
            android:padding="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_alignParentTop="true" />

    <TextView
            android:id="@+id/tvCenterInParent"
            android:text="centerInParent (horizontal + vertikal)"
            android:background="@color/blue_100"
            android:textColor="@color/white"
            android:gravity="center"
            android:padding="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true" />
</RelativeLayout>